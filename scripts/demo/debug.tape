# Companion to examples/demo. Regenerate with: make demo-gif
# Expects ./bin/demo to exist; the Makefile target builds it first.
Output docs/img/demo-debug.gif

Set FontSize 14
Set Width 800
Set Height 440
Set Padding 14
Set Theme "Catppuccin Mocha"
Set TypingSpeed 40ms

Sleep 500ms
Type "./bin/demo debug"
Sleep 400ms
Enter
Sleep 6s
Sleep 3s
